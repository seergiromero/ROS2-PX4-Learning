Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Cell Size: 1
      Color: 160; 160; 160
      Line Style: Lines
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: base_link
      Alpha: 0.5
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Lidar 3D
      Topic: /lidar_3d/points
      Size (Pixels): 2
      Style: Points
    - Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: Fast-LIO Map
      Topic: /Laser_map
      Size (Pixels): 2
      Style: Points
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Depth PointCloud
      Topic: /depth_camera/points
      Size (Pixels): 2
      Size (m): 0.02
      Style: Points
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Frontiers
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /exploration/frontiers
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Best Frontier
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /best_frontier_marker
      Value: true
    - Class: rviz_default_plugins/Pose
      Enabled: true
      Name: Exploration Goal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /exploration/goal
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Frontier Pose Filter
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /frontier_pose_filter_marker
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: A* Path
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /exploration/path
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: A* Path Marker
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /exploration/path_marker
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: Drone
      Visual Enabled: true
      Collision Enabled: false
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Value: true
      Description Source: Topic
    - Class: rviz_default_plugins/LaserScan
      Enabled: false
      Name: Lidar Scan
      Topic: /lidar_3d/scan
      Size (Pixels): 2
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 10
      Min Value: 0.2
      Median window: 5
      Name: Depth Image
      Normalize Range: false
      Topic: /depth_camera/image
  Global Options:
    Fixed Frame: map
    Background Color: 48; 48; 48
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 8
      Focal Point: 0; 0; 0
      Pitch: 0.6
      Yaw: 0.8
Window Geometry:
  Width: 1200
  Height: 800
